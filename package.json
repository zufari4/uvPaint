{
  "name": "uvpaint",
  "version": "1.0.2",
  "private": true,
  "description": "Base color texture studio with UV guides and live 3D preview",
  "author": "UV Paint",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && tsc -p tsconfig.electron.json && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:materials": "node scripts/regression-material.mjs",
    "test:lighting": "node scripts/regression-lighting.mjs",
    "test:paint": "node scripts/regression-paint.mjs",
    "test:interaction": "node scripts/regression-interaction.mjs",
    "test:transform": "node scripts/regression-transform.mjs",
    "test:transform-visibility": "node scripts/regression-transform-visibility.mjs",
    "test:workspace": "node scripts/regression-workspace.mjs",
    "test:islands": "node scripts/regression-islands.mjs",
    "test:layer-islands": "node scripts/regression-layer-islands.mjs",
    "test:import": "node scripts/regression-import.mjs",
    "test:undo": "node scripts/regression-undo.mjs",
    "test:fill": "node scripts/regression-fill.mjs",
    "test:filter": "node scripts/regression-filter.mjs",
    "test:line": "node scripts/regression-line.mjs",
    "test:tools": "node scripts/regression-tools.mjs",
    "test:about": "node scripts/regression-about.mjs",
    "test:layers-panel": "node scripts/regression-layers-panel.mjs",
    "test:project": "node scripts/regression-project.mjs",
    "test:recent": "node scripts/regression-recent.mjs",
    "test:model-loading": "node scripts/regression-model-loading.mjs",
    "test:reload": "node scripts/regression-reload.mjs",
    "test:selection": "node scripts/regression-selection.mjs",
    "test:docking-import": "node scripts/regression-docking-import.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "dist": "npm run build && electron-builder --win --x64 --dir",
    "dist:installer": "npm run build && electron-builder --win nsis --x64",
    "pack:npm": "npm run build && node scripts/pack-npm.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "ml-matrix": "^6.12.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^45.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "studio.uvpaint.desktop",
    "productName": "uvPaint",
    "directories": {
      "output": "release/current"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "uvPaint",
      "artifactName": "uvPaint-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
